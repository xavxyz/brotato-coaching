# Copy to .env and fill in. .env is gitignored; no real Steam ID belongs in this repo.

# The Steam ID naming your Brotato save directory:
#   ~/Library/Application Support/Brotato/<STEAM_ID>/save_v3_0.json
# Leave unset to have the save directory discovered by globbing that directory
# instead. A 17-digit number; the value below is a placeholder, not an account.
STEAM_ID=00000000000000000

# Overrides, for pointing the tooling somewhere other than the real thing. All
# three are optional and none belongs in a normal .env; they exist so tests and
# one-off inspections can run against a directory of their own.
#
# BROTATO_RUN_STATE_PATH   the live run state file `watch` reads
#                          (default: <save directory>/run_v3_0.json)
# BROTATO_RUNS_DIR         where snapshots are written (default: runs/)
# BROTATO_POLL_INTERVAL    seconds between reads of the live state (default: 2)
